RAOMITRA_DB_HOST=127.0.0.1
RAOMITRA_DB_PORT=3306
RAOMITRA_DB_USER=root
RAOMITRA_DB_PASS=
RAOMITRA_DB_NAME=raomitra
RAOMITRA_DB_SSL=0
# XAMPP phpMyAdmin uses the values above on your PC only.
# The original Aiven database is `defaultdb`. Vercel variables belong to a project,
# so restore them in Settings > Environment Variables after recreating the project.
# Set either DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
# (URL-encode special characters in USER and PASSWORD), or set:
# RAOMITRA_DB_HOST, RAOMITRA_DB_PORT, RAOMITRA_DB_USER, RAOMITRA_DB_PASS,
# RAOMITRA_DB_NAME=defaultdb, RAOMITRA_DB_SSL=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RAOMITRA_SESSION_SECRET=change-this-on-vercel
