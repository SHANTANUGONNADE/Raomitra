RAOMITRA_DB_HOST=127.0.0.1
RAOMITRA_DB_PORT=3306
RAOMITRA_DB_USER=root
RAOMITRA_DB_PASS=
RAOMITRA_DB_NAME=raomitra
RAOMITRA_DB_SSL=0
# XAMPP phpMyAdmin uses the values above on your PC only.
# Vercel cannot reach 127.0.0.1. Create a hosted MySQL (Aiven, Railway, PlanetScale, RDS)
# named raomitra, then set these in Vercel → Settings → Environment Variables:
# RAOMITRA_DB_HOST, RAOMITRA_DB_PORT, RAOMITRA_DB_USER, RAOMITRA_DB_PASS, RAOMITRA_DB_SSL=1
# or a single DATABASE_URL=mysql://user:pass@host:3306/raomitra
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RAOMITRA_SESSION_SECRET=change-this-on-vercel
